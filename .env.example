# Discord OAuth2 Configuration
# Discord Developer Portal (https://discord.com/developers/applications) から取得してください

# アプリケーションの Client ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# アプリケーションの Client Secret
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# OAuth2 リダイレクトURI (Discord Developer Portal の OAuth2 > Redirects に登録したものと完全一致させる必要があります)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 要求スコープ（デフォルトは identify のみ。email や guilds, connections を含める場合はスペース区切りで指定）
DISCORD_SCOPES=identify

# セッション暗号化用シークレットキー（32文字以上のランダムな文字列）
SESSION_SECRET=a_very_secret_session_encryption_key_32bytes_long_discord_oauth
